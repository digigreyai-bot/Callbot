# ─────────────────────────────────────────────────────────────
# Call Bot Local App — environment configuration
# Copy this file to ".env" and restart: npm run dev
#
# PHONE NUMBER GUIDE (where each number is used):
#   Lead TO number     → entered in app UI (/outbound-campaign, /lead-flow)
#                        NOT stored here — comes from dashboard/lead form
#   SMS FROM           → TWILIO_FROM_NUMBER (+ Messaging Service Sender Pool)
#   AI CALL FROM       → RETELL_FROM_NUMBER (Retell outbound caller ID)
#   Retell webhook     → set in Retell agent UI (not here):
#                        https://<your-ngrok>/api/webhooks/retell
# ─────────────────────────────────────────────────────────────

# ── Retell AI (voice calls — NOT SMS) ─────────────────────
RETELL_API_KEY=
# Inbound agent — Adrian Trusted Advisor (inbound calls to RETELL_FROM_NUMBER)
RETELL_INBOUND_AGENT_ID=
# Outbound agent — Asim22222_Outbound / Adrian Connector (AI calls after SMS YES)
RETELL_OUTBOUND_AGENT_ID=
# Caller ID for outbound AI phone calls (from_number in Retell API)
RETELL_FROM_NUMBER=

# ── Twilio (SMS only — lead_flow + outbound campaign) ─────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Messaging Service — add TWILIO_FROM_NUMBER to Sender Pool in Twilio console
TWILIO_MESSAGING_SERVICE_SID=
# SMS from number (DigiGrey — Glen Carbon IL). Must be in Messaging Service Sender Pool.
TWILIO_FROM_NUMBER=

# ── LLM extraction / SMS yes-no decision ──────────────────
EXTRACTION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Google Calendar (post-call appointment events) ──────────
GOOGLE_CALENDAR_ID=
# Share this calendar with GOOGLE_SERVICE_ACCOUNT_EMAIL — "Make changes to events"
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── General ────────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Karachi

# Outbound campaign: wait for SMS reply before checking (default 300 = 5 min)
OUTBOUND_SMS_WAIT_SEC=300
OUTBOUND_RETRY_WAIT_SEC=600

# ── Agent Assist Plus dashboard (POST call/lead results) ──
# Get DASHBOARD_API_KEY + DASHBOARD_CLIENT_ID from dashboard Client Management
DASHBOARD_API_URL=https://backendaap.agentassistplus.com/api/make/cp/outboundcalls
DASHBOARD_INBOUND_URL=https://backendaap.agentassistplus.com/api/make/cp/inboundcalls
DASHBOARD_API_KEY=
DASHBOARD_CLIENT_ID=
DASHBOARD_LEAD_URL=https://backendaap.agentassistplus.com/api/make/lf/leads
